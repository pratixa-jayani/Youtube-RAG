{
    "manifest_version": 3,

    "name": "YouTube RAG Assistant",

    "version": "1.0.0",

    "description": "Ask questions about YouTube videos using RAG.",

    "permissions": [
        "activeTab",
        "tabs"
    ],

    "host_permissions": [
        "http://127.0.0.1:8000/*",
        "http://localhost:8000/*",
        "https://www.youtube.com/*"
    ],

    "action": {
        "default_popup": "popup.html"
    }
}